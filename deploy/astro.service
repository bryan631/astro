# Install: sudo cp deploy/astro.service /etc/systemd/system/ && sudo systemctl enable --now astro
# Assumes the repo is at /home/astro/astro and runs as user 'astro'; adjust if different.
[Unit]
Description=astro telescope server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=astro
WorkingDirectory=/home/astro/astro
ExecStart=/home/astro/astro/scripts/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
