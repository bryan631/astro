# Install with astro-cert.service: sudo systemctl enable --now astro-cert.timer
[Unit]
Description=Monthly astro cert renewal

[Timer]
# Midday on the 1st, never during an observing night. A run missed while the MiniPC was off
# happens at the next boot, before a session starts, so a restart then costs nothing.
OnCalendar=*-*-01 12:00:00
Persistent=true

[Install]
WantedBy=timers.target
